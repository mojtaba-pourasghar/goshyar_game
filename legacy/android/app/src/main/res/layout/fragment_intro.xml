<?xml version="1.0" encoding="utf-8"?>
<!-- معرفی اپ: پس‌زمینه کرم، کارت سفید با گوش‌یار دست‌تکان‌دهنده، دکمه نارنجی، نقطه‌های صفحه -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_cream"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4" />

    <LinearLayout
        android:id="@+id/card_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white_lg"
        android:elevation="3dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/intro_title"
            android:textColor="@color/purple_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/intro_body"
            android:textColor="@color/text_dark"
            android:textSize="16sp" />

        <ir.brandimo.goshyar.ui.views.MascotView
            android:id="@+id/mascot_intro"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/app_name" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_intro_go"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_pill_orange"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="@string/let_us_go"
        android:textColor="@color/white"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <View
            android:layout_width="22dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/dot_active" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/dot_idle" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/dot_idle" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/dot_idle" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6" />
</LinearLayout>
