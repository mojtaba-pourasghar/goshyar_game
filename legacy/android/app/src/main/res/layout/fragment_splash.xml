<?xml version="1.0" encoding="utf-8"?>
<!-- صفحه شروع: تصویر تمام‌صفحه جنگل، لوگو بالا، گوش‌یار وسط، دکمه پخش گرد، شعار پایین -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_sky">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_sunny_forest" />

    <ImageButton
        android:id="@+id/btn_splash_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/circle_white"
        android:contentDescription="@string/settings"
        android:padding="10dp"
        android:src="@drawable/ic_settings_gear"
        android:tint="@color/purple_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="6"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="46sp"
            android:textStyle="bold" />

        <ir.brandimo.goshyar.ui.views.MascotView
            android:id="@+id/mascot_view"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/app_name" />

        <ImageButton
            android:id="@+id/btn_start"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/circle_orange"
            android:contentDescription="@string/start"
            android:elevation="6dp"
            android:padding="24dp"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:text="@string/app_tagline"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:text="@string/app_slogan"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
