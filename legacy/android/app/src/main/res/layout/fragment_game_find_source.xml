<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/purple_background">

    <TextView
        android:id="@+id/tv_game_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مرحله ۱ از ۱۰"
        android:textColor="@color/purple_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ir.brandimo.goshyar.ui.views.SoundWaveView
        android:id="@+id/sound_wave_view"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp" />

    <ImageButton
        android:id="@+id/btn_play_sound"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_category_card_cyan"
        android:src="@android:drawable/ic_media_play"
        android:tint="@color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/game_find_source_instruction"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:gravity="center" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:columnCount="2"
        android:rowCount="2">

        <Button
            android:id="@+id/btn_option_forest"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:text="جنگل"
            android:backgroundTint="@color/success_green" />

        <Button
            android:id="@+id/btn_option_cave"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:text="غار تاریک"
            android:backgroundTint="@color/purple_medium" />

        <Button
            android:id="@+id/btn_option_river"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:text="رودخانه"
            android:backgroundTint="@color/turquoise_accent" />

        <Button
            android:id="@+id/btn_option_house"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="6dp"
            android:text="خانه روستایی"
            android:backgroundTint="@color/gooshi_orange" />
    </GridLayout>

</LinearLayout>
