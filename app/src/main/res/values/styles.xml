<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.GoshyarGame" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_medium</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/gooshi_orange</item>
        <item name="colorSecondaryVariant">@color/gooshi_orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background and window styling -->
        <item name="android:windowBackground">@color/purple_background</item>
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Round Button Style -->
    <style name="Widget.Goshyar.Button.Green" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/success_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.Goshyar.Button.Orange" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/gooshi_orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.Goshyar.Button.Purple" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- کاشی رنگی منو: مربع گرد با آیکون سفید و برچسب زیرش -->
    <style name="Widget.Goshyar.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">118dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">3dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="Widget.Goshyar.Tile.Icon" parent="">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.Goshyar.Tile.Label" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>
