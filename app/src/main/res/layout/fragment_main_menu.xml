<?xml version="1.0" encoding="utf-8"?>
<!-- منوی اصلی: سلام + چیپ امتیاز، چهار کاشی رنگی بازی، دکمه همه دسته‌بندی‌ها -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- سلام و امتیاز -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_gold"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_fill"
                    android:tint="@color/gold_star" />

                <TextView
                    android:id="@+id/tv_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/gooshi_orange_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_child_greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/purple_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ir.brandimo.goshyar.ui.views.MascotView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/app_name" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:text="@string/what_to_play_today"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <!-- چهار حالت بازی -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_mode_find_source"
                style="@style/Widget.Goshyar.Tile"
                android:layout_marginEnd="7dp"
                android:background="@drawable/tile_purple">

                <ImageView
                    style="@style/Widget.Goshyar.Tile.Icon"
                    android:src="@drawable/ic_ear" />

                <TextView
                    style="@style/Widget.Goshyar.Tile.Label"
                    android:text="@string/mode_find_source" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_mode_who_made_sound"
                style="@style/Widget.Goshyar.Tile"
                android:layout_marginStart="7dp"
                android:background="@drawable/tile_orange">

                <ImageView
                    style="@style/Widget.Goshyar.Tile.Icon"
                    android:src="@drawable/ic_paw" />

                <TextView
                    style="@style/Widget.Goshyar.Tile.Label"
                    android:text="@string/mode_who_made_sound" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_mode_sequence"
                style="@style/Widget.Goshyar.Tile"
                android:layout_marginEnd="7dp"
                android:background="@drawable/tile_green">

                <ImageView
                    style="@style/Widget.Goshyar.Tile.Icon"
                    android:src="@drawable/ic_grid" />

                <TextView
                    style="@style/Widget.Goshyar.Tile.Label"
                    android:text="@string/mode_sound_sequence" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_mode_audio_mission"
                style="@style/Widget.Goshyar.Tile"
                android:layout_marginStart="7dp"
                android:background="@drawable/tile_blue">

                <ImageView
                    style="@style/Widget.Goshyar.Tile.Icon"
                    android:src="@drawable/ic_wave" />

                <TextView
                    style="@style/Widget.Goshyar.Tile.Label"
                    android:text="@string/mode_audio_mission" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_all_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_pill_purple"
            android:elevation="3dp"
            android:gravity="center"
            android:paddingVertical="15dp"
            android:text="@string/all_games"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
