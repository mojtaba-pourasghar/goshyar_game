<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_mint"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ir.brandimo.goshyar.ui.views.MascotView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/offline_mode_title"
        android:textColor="@color/purple_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/offline_mode_desc"
        android:textColor="@color/text_dark"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/progress_offline"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="24dp"
        android:progressTint="@color/turquoise_accent" />

    <TextView
        android:id="@+id/tv_offline_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_check_offline"
        style="@style/Widget.Goshyar.Button.Green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/check_offline_content" />
</LinearLayout>
