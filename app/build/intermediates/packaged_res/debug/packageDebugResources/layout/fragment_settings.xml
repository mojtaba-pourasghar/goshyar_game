<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/purple_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@color/purple_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_bg_music"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:checked="true"
        android:text="@string/settings_bg_music"
        android:textColor="@color/text_dark"
        android:textSize="16sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_sfx"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:checked="true"
        android:text="@string/settings_sound_effects"
        android:textColor="@color/text_dark"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_offline_mode_screen"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="مدیریت حالت آفلاین"
        android:backgroundTint="@color/purple_medium" />

    <Button
        android:id="@+id/btn_settings_back"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:text="@string/back"
        android:backgroundTint="@color/gooshi_orange" />

</LinearLayout>
