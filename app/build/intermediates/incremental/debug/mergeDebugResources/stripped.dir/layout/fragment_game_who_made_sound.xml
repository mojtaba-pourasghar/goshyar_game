<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/purple_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مرحله ۱ از ۱۰"
        android:textColor="@color/purple_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btn_play_animal_sound"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_category_card_orange"
        android:src="@android:drawable/ic_media_play"
        android:tint="@color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/game_who_made_sound_question"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:gravity="center"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_choice_rabbit"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_rounded_card_white"
            android:src="@drawable/anim_rabbit"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btn_choice_lion"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_rounded_card_white"
            android:src="@drawable/anim_lion"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btn_choice_cow"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_rounded_card_white"
            android:src="@drawable/anim_cow"
            android:scaleType="fitCenter" />
    </LinearLayout>

</LinearLayout>
